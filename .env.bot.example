# Copy to .env.bot on your server. Never commit real keys or send them in chat.
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# Exact model ID from your OpenRouter account; no default or silent fallback.
OPENROUTER_MODEL=
# Optional: comma-separated numeric Telegram user IDs. Empty = public access.
# Set this before launching if you want a private test and limited costs.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: your writing style, not private conversations or personal information.
BOT_STYLE="ملایم و خودمونی، جمله‌های کوتاه، بدون نصیحت عجولانه و با ایموجی‌های مرتبط."

# Cloudflare webhook only: random 32–256 URL-safe characters; same secret in Worker.
TELEGRAM_WEBHOOK_SECRET=
