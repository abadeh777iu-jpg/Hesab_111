# Copy to .env.bot on your server. Never commit real keys or send them in chat.
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# Exact model ID from your OpenRouter account; no default or silent fallback.
OPENROUTER_MODEL=
# Optional: comma-separated numeric Telegram user IDs. Empty = public access.
# Set this before launching if you want a private test and limited costs.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: your writing style, not private conversations or personal information.
BOT_STYLE="ملایم و خودمونی، جمله‌های کوتاه، بدون نصیحت عجولانه و با ایموجی‌های مرتبط."

# Cloudflare webhook only: random 32–256 URL-safe characters; same secret in Worker.
TELEGRAM_WEBHOOK_SECRET=

# Optional Cloudflare-only market data. Do not share real keys.
NAVASAN_API_KEY=
# Confirm the provider response unit: toman or rial. No implicit default.
NAVASAN_PRICE_UNIT=
# Safe shared upstream request budget; adjust only after checking your plan.
NAVASAN_DAILY_LIMIT=3
NAVASAN_CACHE_MINUTES=15

# Cloudflare-only media: enter the Free.ai key as a Secret in the dashboard.
# Chat stays on OpenRouter; do not replace OPENROUTER_API_KEY.
# Legacy MEDIA_PROVIDER now affects images only.
MEDIA_IMAGE_PROVIDER=freeai
MEDIA_VOICE_PROVIDER=openrouter
FREEAI_API_KEY=
FREEAI_IMAGE_MODEL=sdxl
# Default voice uses the existing OPENROUTER_API_KEY, not the Free.ai key.
OPENROUTER_SPEECH_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_VOICE=Charon
# Inactive unless the owner explicitly selects MEDIA_VOICE_PROVIDER=freeai.
FREEAI_TTS_MODEL=
FREEAI_TTS_VOICE=
