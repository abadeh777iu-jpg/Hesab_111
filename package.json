{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "assets:video": "node scripts/download-video.mjs",
    "bot": "node --env-file=.env.bot bot/index.mjs",
    "test:bot": "node --test bot/*.test.mjs",
    "bot:cf:deploy": "wrangler deploy",
    "bot:cf:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "bot:webhook": "node --env-file=.env.bot bot/set-webhook.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-router": "^1.170.39",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.12.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.1.17",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.156.0"
  }
}
