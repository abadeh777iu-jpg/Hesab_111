{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamrah-telegram-bot",
  "main": "bot/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "CHATS", "class_name": "ChatSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatSession"] }],
  "vars": {
    "OPENROUTER_MODEL": "",
    "TELEGRAM_ALLOWED_USER_IDS": "",
    "BOT_STYLE": "ملایم و خودمونی، جمله‌های کوتاه، بدون نصیحت عجولانه و ایموجی کم."
  }
}
